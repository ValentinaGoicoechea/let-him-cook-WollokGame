// source/tests.wtest
import comida.*
import ambiente.*
import personajeprincipal.*
import pedidos.*
import puntaje.*
import estados.*
import tareas.*


describe "Tests preliminares TPGame-Overcooked" {

    test "Al cortarse una papa, esta cambia su estado, su tipo e imagen." {
        const papa = new Comida(tipo = tipoPapa, position = game.at(4,9))

        tareaCortar.ejecutar(papa)

        assert.equals(cortada, papa.estado())
        assert.equals("imagenesComida-Vajilla/papaCortada.png", papa.image())
    }

    test "Una pechuga cruda se puede cocinar o tirar." {
        const pechuga = new Comida(tipo=tipoPollo, position = game.at(10, 10))

        assert.equals(true, pechuga.tareas().contains(tareaCocinar))
        assert.equals(true, pechuga.tareas().contains(tareaTirar))
    }

    test "El stock inicial de pechugas y de papas es de 5 (cada uno)." {
        cajonDePapas.reponerStock() //Estos van porque es lo que hace program juego al ejecutar.
        cajonDePollo.reponerStock()
        
        assert.equals(5, cajonDePapas.cantidadEnStock())
        assert.equals(5, cajonDePollo.cantidadEnStock())
    }

    test "Cuando se tira una pechuga al tacho de basura, esta desaparece." {
        const pechuga1 = new Comida(tipo = tipoPollo, position = game.at(6,3)) 
        game.addVisual(pechuga1)       
        
        tareaTirar.ejecutar(pechuga1) 

        assert.equals(false, game.allVisuals().contains(pechuga1))

    }

    test "El cajón de pollo no repone si tiene stock máximo." {  //Este queda medio raro porque
                                                                  // no tenemos forma de llevar a 1, 2, 3...
                                                                  // la cantidad de pollos.
        
        cajonDePollo.reponerStock()
        assert.equals(5, cajonDePollo.cantidadEnStock())
        
    }

    test "Un plato armado con más de un elemento se puede agarrar." {
        const plato = new Plato(
            position = game.at(10, 10),
            estado = limpio)

        const papa = new Comida(
            tipo = tipoPapa,
            position = game.at(10, 10),
            estado = cocinada)

                
        const mesadaArmado1 = new MesadaArmado(
            position = game.at(25,7),
            image = "imagenesEstaciones/mesadaArmado.png"
        )

        const platoArmado = new PlatoArmado(
            mesadaActual = mesadaArmado1,
            position = game.at(10, 10),
            elementosPlato = [plato, papa])

        assert.equals(true, platoArmado.sePuedeAgarrar())
    }

    test "Un plato armado de pollo con papas coincide con el pedido, lo marca como entregado y lo saca de la lista." {
        generadorDePedidos.listaPedidos().clear() //para el test 'empiezo desde 0' sin pedidos

        const pedido = new Pedido(
            receta = polloConPapas,
            position = game.at(27, 3)
        )
        generadorDePedidos.agregarNuevoPedido(pedido)

        const plato = new Plato(position = game.at(10, 10),estado = limpio) 
        const papa = new Comida(tipo = tipoPapa,position = game.at(10, 10),estado = cocinada)
        const pechuga = new Comida(tipo=tipoPollo, position = game.at(10, 10), estado = cocinada)     
        const mesadaArmado1 = new MesadaArmado(position = game.at(25,7),image = "imagenesEstaciones/mesadaArmado.png")
        const platoArmado = new PlatoArmado(mesadaActual = mesadaArmado1,position = game.at(10, 10),elementosPlato = [plato, papa, pechuga])      
        const mesadaEntrega1 = new MesadaEntrega(position = game.at(14,11),image = "imagenesEstaciones/mesada.png")
        mesadaEntrega1.tareaDeEstacion(platoArmado)

        assert.equals(true, pedido.seEntrego())
        assert.equals(false, generadorDePedidos.listaPedidos().contains(pedido))
    }

    test "Despues de entregar, el plato usado queda sucio" {
        generadorDePedidos.listaPedidos().clear()
 
        const pedido = new Pedido(
            receta = polloConPapas,
            position = game.at(27, 3)
        )
        generadorDePedidos.agregarNuevoPedido(pedido)

        const plato = new Plato(position= game.at(24, 7), estado = limpio)
        const pechuga = new Comida(tipo = tipoPollo,position = game.at(24, 7), estado = cocinada) 
        const papa = new Comida(tipo = tipoPapa, position = game.at(24, 7), estado = cocinada)
        const mesadaArmado1 = new MesadaArmado(position = game.at(25,7),image = "imagenesEstaciones/mesadaArmado.png")
        const platoArmado = new PlatoArmado(mesadaActual = mesadaArmado1,position = game.at(10, 10),elementosPlato = [plato, papa, pechuga])      
        const mesadaEntrega = new MesadaEntrega(position = game.at(14, 11), image = "mesada.png")

        mesadaEntrega.tareaDeEstacion(platoArmado)

        assert.equals(sucio, plato.estado())
    }

    test "Al entregar un plato que no coincide con ninguna receta, resta 100 puntos"{
        generadorDePedidos.listaPedidos().clear()
        puntajeEnJuego.valor(300)
        
    
        const pedido = new Pedido(
            receta = ojoDeBifeConHuevo,
            position = game.at(27, 3)
        )
        generadorDePedidos.agregarNuevoPedido(pedido)

        const plato = new Plato(position= game.at(24, 7), estado = limpio)
        const pechuga = new Comida(tipo = tipoPollo,position = game.at(24, 7), estado = cocinada) 
        const mesadaArmado1 = new MesadaArmado(position = game.at(25,7),image = "imagenesEstaciones/mesadaArmado.png")
        const platoArmado = new PlatoArmado(mesadaActual = mesadaArmado1,position = game.at(10, 10),elementosPlato = [plato, pechuga])   
        const mesadaEntrega = new MesadaEntrega(position = game.at(14, 11), image = "mesada.png")

        mesadaEntrega.tareaDeEstacion(platoArmado)

        assert.equals(200, puntajeEnJuego.valor())
    }

    test "Es posible ir con un plato ya con comida y seguir agregando ingredientes"{
        const plato = new Plato(position= game.at(24, 7), estado = limpio)
        const pechuga = new Comida(tipo = tipoPollo,position = game.at(24, 7), estado = cocinada) 
        const papa = new Comida(tipo = tipoPapa, position = game.at(24, 7), estado = cocinada)
        const mesadaArmado1 = new MesadaArmado(position = game.at(25,7),image = "imagenesEstaciones/mesadaArmado.png")
        const platoArmado = new PlatoArmado(mesadaActual = mesadaArmado1,position = game.at(10, 10),elementosPlato = [plato, papa])   
        const mesadaEntrega = new MesadaEntrega(position = game.at(14, 11), image = "mesada.png")

        mesadaArmado1.tareaDeEstacion(platoArmado)
        mesadaArmado1.tareaDeEstacion(pechuga)

        assert.equals([plato, papa, pechuga], mesadaArmado1.platoEnArmado().elementosPlato())
    }


}