// source/tests.wtest
import comida.*
import ambiente.*
import personajeprincipal.*
import pedidos.*
import puntaje.*


describe "Tests preliminares TPGame-Overcooked" {

    test "Al cortarse una papa, esta cambia su estado, su tipo e imagen." {
        const papa = new Papa(position = game.at(4,9),
                              modificado = "")

        papa.modificado("cortada")

        assert.equals("cortada", papa.modificado())
        assert.equals("papaCortada", papa.elementoYEstado())
        assert.equals("papaCortada.png", papa.image())

    }

    test "Una pechuga cruda se puede cocinar o tirar." {
        const pechuga = new PechugaDePollo(position = game.at(10, 10),
                                           modificado = "")

        assert.equals(true, pechuga.tareas().contains("cocinar"))
        assert.equals(true, pechuga.tareas().contains("tirar"))
    }

    test "El stock inicial de pechugas y de papas es de 5 (cada uno)." {
        cajonDePapas.reponerStock() //Estos van porque es lo que hace program juego al ejecutar.
        cajonDePollo.reponerStock()
        
        assert.equals(5, cajonDePapas.cantidadEnStock())
        assert.equals(5, cajonDePollo.cantidadEnStock())
    }

    test "Cuando se tira una pechuga al tacho de basura, esta desaparece." { //Seguramente haya que
                                                                            //modificar esto porque la 
                                                                            //basura tarda 500ms en tirar cosas
        const pechuga1 = new PechugaDePollo(position = game.at(6,3),
                                           modificado = "")
        const basura1 = new Estacion(
            position = game.at(25,7),
            prendido = false,
            estaOcupado = false,
            tiempoTarea = 0,
            imagen1 = "basuraAbierta.png",
            imagen2 = "basura.png",
            valorOtorgado = "tirado",
            debeValidar = "tirar",
            numeroEstacion = 1
        )
        
        basura1.tareaDeEstacion(pechuga1)

        assert.equals("tirado", pechuga1.modificado())
        assert.equals("vacio.png", pechuga1.image())

    }

    test "El cajón de pollo no repone si tiene stock máximo." {  //Este queda medio raro porque
                                                                  // no tenemos forma de llevar a 1, 2, 3...
                                                                  // la cantidad de pollos.
        
        cajonDePollo.reponerStock()
        assert.equals(5, cajonDePollo.cantidadEnStock())
        
    }

    test "Un plato armado con más de un elemento se puede agarrar." {
        const plato = new Plato(
            position = game.at(10, 10),
            modificado = "limpio")

        const papa = new Papa(
            position = game.at(10, 10),
            modificado = "cocinado")

        const platoArmado = new PlatoArmado(
            position = game.at(10, 10),
            elementosPlato = [plato, papa])

        assert.equals(true, platoArmado.sePuedeAgarrar())
    }

    test "Un plato armado de pollo con papas coincide con el pedido, lo marca como entregado y lo saca de la lista." {
        generadorDePedidos.listaPedidos().clear() //para el test 'empiezo desde 0' sin pedidos

        const pedido = new PedidoPolloConPapas(
            position = game.at(27, 3),
            ingredientes = ["plato", "pechugaCocinada", "papasFritas"])
        generadorDePedidos.listaPedidos().add(pedido)

        const plato = new Plato(position= game.at(24, 7), modificado = "limpio")
        const pechuga = new PechugaDePollo(position = game.at(24, 7), modificado = "cocinado") 
        //uso "cocinado" ya que no me importa si las demas estaciones funcionan, solo evaluo la entrega
        const papa = new Papa(position = game.at(24, 7), modificado= "cocinado")
        const platoArmado = new PlatoArmado(position = game.at(24, 7), elementosPlato = [plato, pechuga, papa])
        const mesadaEntrega = new MesadaEntrega(position = game.at(14, 11), image = "mesada.png")

        mesadaEntrega.tareaDeEstacion(platoArmado)

        assert.equals(true, pedido.seEntrego())
        assert.equals(false, generadorDePedidos.listaPedidos().contains(pedido))
    }


}