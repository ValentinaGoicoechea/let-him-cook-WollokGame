import wollok.game.*
import teclado.*
import personajeprincipal.*
import ambiente.*
import comida.*

program juego{
    game.width(28)
    game.height(16)
    game.cellSize(50)
    game.title("Overcooked") //a chequear si despues lo cambiamos
    game.boardGround("fondo.png")
    game.addVisual(horno)
    game.addVisual(mesadaEntrega)
    game.addVisual(mesadaArmado)
    game.addVisual(tablaDeCortar)
    game.addVisual(basura)
    game.addVisual(bacha)
    game.addVisual(personajePrincipal)
    game.addVisual(plato1)
    game.addVisual(pechuga1)
    game.addVisual(pechuga2)
    game.addVisual(pechuga3)
    game.addVisual(pechuga4)
    game.addVisual(pechuga5)

    teclado.movimiento()
    teclado.agarrarOSoltarObjeto()
    teclado.realizarAccion()
    game.onTick(100, "moverCocinero", { personajePrincipal.darPaso() }) //sirve para que pueda avanzar manteniendo presionado, pregunta cada 100ms a donde da un paso

    game.start()
    //game.ground("archivo de la imagen") o game.boardGround("nombre de archivo")
}