import wollok.game.*
import teclado.*
import controladorPantallasYNiveles.*


program programa{
    game.width(32)
    game.height(16)
    game.cellSize(50)
    game.title("LET HIM COOK")
    game.boardGround("imagenesFondos/fondoCocina.png")
    
    controladorPantallas.cambiarPantalla(pantallaInicio)
    controladorPantallas.configurarEnter()

    game.start()
   
}
